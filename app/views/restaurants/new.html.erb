<h1>Add a restaurant</h1>

<%= simple_form_for @restaurant do |form| %>
  <%= form.input :name %>
  <%= form.input :address %>
  <%= form.input :category %>
  <%= form.input :phone_number %>

  <%= form.button :submit, "Create restaurant" %>
<% end %>

<%= link_to "Back to mainpage", restaurants_path %>
